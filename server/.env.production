# ═══════════════════════════════════════════════════════════════
# TECCIA - Backend - Variables de Entorno para PRODUCCIÓN (VPS)
# Dominio: k4.com.ar
# ═══════════════════════════════════════════════════════════════

# Puerto del servidor
PORT=3002

# Secreto para JWT (¡CAMBIAR ESTO POR UN VALOR SEGURO!)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_ESTO_POR_UN_SECRETO_SEGURO_DE_64_CARACTERES

# Entorno
NODE_ENV=production

# Origen permitido para CORS
ALLOWED_ORIGIN=https://k4.com.ar

# ═══════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE WHATSAPP (Puppeteer/Chromium)
# ═══════════════════════════════════════════════════════════════

# Ruta donde se guardan las sesiones de WhatsApp
# Por defecto: ./.wwebjs_auth (relativo a server/)
# Para VPS, usar ruta absoluta:
WA_SESSIONS_PATH=/var/www/teccia/server/.wwebjs_auth

# Ruta al ejecutable de Chromium/Chrome
# Ubuntu 22.04: /usr/bin/chromium-browser
# Ubuntu 20.04: /usr/bin/chromium
# Si no se especifica, Puppeteer descarga su propia versión
CHROME_PATH=/usr/bin/chromium-browser
